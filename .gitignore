# Ignore entire Vivado generated folders (any depth, any project)
**/*.cache/
**/*.runs/
**/*.sim/
**/*.hw/
**/*.gen/
**/*.ip_user_files/
**/*.srcs/
*.xpr

# EXCEPTIONS — keep these even though they're inside .srcs
!**/*.srcs/sources_1/bd/**/*.bd
!**/*.srcs/sources_1/new/**/*.coe
!**/*.srcs/sources_1/new/**/*.mem
!**/*.srcs/sources_1/imports/**/*.coe
!**/*.srcs/sources_1/imports/**/*.mem
!**/*.srcs/sources_1/ip/**/*.xci

# Individual Vivado junk file types
*.jou
*.log
*.str
*.tmp
*.bak
*~
*.bit
*.bin
*.ltx
*.mmi
*.webtalk
*.xml
*.wdb
*.vcd
*.pb
*.o
*.obj
*.dcp
*.rpt
*.rpx
*.vdi
*.vds
*.tcl
*.bat
*.sh
*.rst
*.wdf
*.wpc
*.lpr
*.ini
*.prj
*.dbg
*.mem
*.reloc
*.rlx
*.rtti
*.svtype
*.type
*.version
*.xdbg
*.sdb
*.dir
.DS_Store
Thumbs.db

# EXCEPTION — allow .bin files to be tracked (overrides *.bin above)
!*.bin